# Database (Neon / Supabase PostgreSQL with Connection Pooling for Vercel)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vensure?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/vensure?schema=public"

# Authentication
AUTH_SECRET="replace-with-openssl-rand-base64-32"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# File Storage (Vercel Blob / S3)
BLOB_READ_WRITE_TOKEN=""

# Email & Transactional Notifications (Resend)
RESEND_API_KEY=""
EMAIL_FROM="Vensure Procurement <noreply@vensure.app>"

# Vercel Cron Secret
CRON_SECRET="replace-with-cron-secret"
